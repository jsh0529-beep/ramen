# ── 1단계 The Brain ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
# 국가유산청 문화유산 Open API (키 불필요, 기본값 유지)
KHS_API_BASE=https://www.khs.go.kr/cha

# ── 2단계 The Eyes ──
# 한국저작권위원회 공유마당 Open API (키 발급: https://gongu.copyright.or.kr)
GONGU_API_KEY=
GONGU_API_BASE=
RUNWAY_API_KEY=
RUNWAY_API_BASE=https://api.dev.runwayml.com/v1

# ── 3단계 The Voice & Sound ──
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
EPIDEMIC_SOUND_API_KEY=
EPIDEMIC_SOUND_API_BASE=

# ── 4단계 The Editor ──
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=24
TARGET_MINUTES=5
SUBTITLE_FONT=

# ── 5단계 The Publisher ──
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_PRIVACY=private
